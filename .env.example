# Sehat Setu — environment variables
#
# This prototype runs entirely on a mock data/service layer (see src/services
# and src/data/seed) and needs NO environment variables to run locally, EXCEPT
# for the "new account" email notification below.
#
# Never commit a filled-in .env.local with real secrets. This file only
# documents variable names; copy it to .env.local and fill in real values
# there.

# --- New-account email (Resend) --------------------------------------------
# Sent when a Doctor or Staff member is added, via src/server/send-account-
# notifications.ts and the /api/notify-new-account route — the ONE place in
# this app with real server-side code (everything else is a mock service).
#
# Free tier: 3,000 emails/month, 100/day, no credit card required.
#   1. Sign up at https://resend.com (email + password, ~1 minute)
#   2. Dashboard -> API Keys -> Create API Key -> copy it here
# Until this is set, the app still works — the in-app "credentials" dialog
# just reports the email as "not sent" and shows the password directly
# instead, so nobody is ever blocked from getting a new account working.
RESEND_API_KEY=

# Optional: only needed once you verify your own sending domain in Resend.
# Until then, mail sends from Resend's shared "onboarding@resend.dev", which
# works with zero setup but is meant for testing, not real clinic use.
RESEND_FROM_EMAIL="Sehat Setu <onboarding@resend.dev>"

# --- New-account SMS (TextBelt) --------------------------------------------
# Works out of the box with NO signup: the literal value "textbelt" (the
# code's default if this is left blank) gives 1 free SMS/day per IP address —
# enough to try the feature. For real clinic use, buy a paid TextBelt key at
# https://textbelt.com (pay-as-you-go, no subscription) or swap in another
# provider (Twilio, MSG91, Fast2SMS) inside send-account-notifications.ts.
TEXTBELT_API_KEY=textbelt

# --- App URL -----------------------------------------------------------------
# Used to build the "Sign in" link inside the new-account email/SMS, as the
# base URL in sitemap.xml/robots.txt, and as the return address of Supabase
# email links (sign-up confirmation, password reset → /auth/callback; see
# src/lib/auth/site-url.ts). Safe to expose to the browser (NEXT_PUBLIC_)
# since it's just this app's own address.
#   Local development: leave it unset or http://localhost:3000. Any non-local
#   value (e.g. an old Vercel preview URL) is ignored in development.
#   Production: your https origin, e.g. https://clinic.example.com (no path).
# It must also be on Supabase → Authentication → URL Configuration → Redirect
# URLs as <origin>/** (e.g. http://localhost:3000/**).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Demo mode badge ---------------------------------------------------------
# Shows a small "Demo" badge on the public site so visitors know all doctors,
# clinics, reviews, and patient data are fictional. Set to "false" to hide it
# once this is pointed at a real backend.
NEXT_PUBLIC_DEMO_MODE=true

# --- Database (Supabase PostgreSQL via Prisma 7) ----------------------------
# Supabase dashboard -> Connect -> ORMs/Prisma for your project's exact values.
# URL-encode special characters in the password. Server-side only — never
# prefix these with NEXT_PUBLIC_.
#
# Runtime queries (src/server/prisma.ts): the least-privileged sehat_app role
# (no BYPASSRLS), transaction-mode pooler, port 6543. Written for you by
# `npm run db:setup-app-role` after `npm run db:migrate`. See docs/security.md.
DATABASE_URL="postgresql://sehat_app.[PROJECT-REF]:[APP-ROLE-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Prisma CLI, seed and admin scripts ONLY (prisma.config.ts): postgres role,
# session-mode pooler, port 5432. postgres bypasses RLS — never use it at runtime.
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# --- Supabase Auth (public values; safe to expose to the browser) ----------
# Dashboard -> Project Settings -> API Keys. Leave unset to run in demo mode
# (client-side demo personas over fictional mock data; no database access).
# Never put the secret / service_role key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="[YOUR-PUBLISHABLE-KEY]"

# --- Supabase Auth admin (SERVER-ONLY secret — never NEXT_PUBLIC_, never committed) --
# Dashboard -> Project Settings -> API Keys -> Secret keys (sb_secret_...).
# Used only by src/server/supabase-admin.ts to email staff invitations through
# the project's configured SMTP. Leave empty and invitations are still saved,
# but show "Delivery failed: email sending isn't configured" until it is set.
SUPABASE_SECRET_KEY=

# --- Future API backend -------------------------------------------------
# Base URL of a real backend once src/services/* are pointed at it instead
# of the in-memory mock store.
NEXT_PUBLIC_API_BASE_URL=

# --- Future AI provider (server-side only — never NEXT_PUBLIC_) --------
# Used by a future server route/action that replaces src/services/ai.ts's
# mock implementations. Keep this server-side; do not prefix with
# NEXT_PUBLIC_ or it will be bundled into client JavaScript.
AI_PROVIDER_API_KEY=


# Patient self-registration: the clinic CODE (e.g. AAR) that new self-registered
# patients join. Chosen by the operator, never the patient. Unset: the only
# active clinic, if exactly one exists (otherwise new patients are refused).
SELF_REGISTRATION_CLINIC=
