/// Reorder level for a medicine at a branch (low stock = usable quantity across batches ≤ this).
model InventoryReorderLevel {
  id           String   @id @default(uuid()) @db.Uuid
  clinicId     String   @db.Uuid
  branchId     String   @db.Uuid
  medicineId   String   @db.Uuid
