  revokedByUserId  String?               @db.Uuid
  createdAt        DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime              @default(now()) @db.Timestamptz(6)

  patient    Patient @relation(fields: [clinicId, patientId], references: [clinicId, id], onDelete: Restrict)
  issuedBy   User    @relation("LinkCodeIssuer", fields: [issuedByUserId], references: [id], onDelete: Restrict)
  redeemedBy User?   @relation("LinkCodeRedeemer", fields: [redeemedByUserId], references: [id], onDelete: Restrict)
  revokedBy  User?   @relation("LinkCodeRevoker", fields: [revokedByUserId], references: [id], onDelete: Restrict)

  @@index([clinicId, createdAt])
