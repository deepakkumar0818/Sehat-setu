// ---------------------------------------------------------------------------
// Audit trail
// ---------------------------------------------------------------------------

enum AuditOutcome {
  SUCCESS
  DENIED
  FAILURE
}

/// Append-only security/audit log. Written only through the database (row
/// triggers and the app.log_event() function); UPDATE, DELETE and TRUNCATE are
/// blocked by triggers. Never stores passwords, tokens, credentials, or
/// clinical content — data-change events record WHICH columns changed, not values.
/// No foreign keys on purpose: audit rows must outlive (and never block) the rows they describe.
model AuditEvent {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  occurredAt  DateTime     @default(now()) @db.Timestamptz(6)
  /// public.users.id of the actor, when known.
  actorUserId String?      @db.Uuid
  /// Supabase auth user id of the actor, when known.
  actorAuthId String?
  /// Non-user actors ("cli:auth:provision", "db:postgres") or the attempted email of a failed sign-in.
  actorLabel  String?
  clinicId    String?      @db.Uuid
  /// e.g. "auth.sign_in", "access.denied", "patients.update", "clinic_memberships.insert".
  action      String
  targetType  String?
  targetId    String?
  outcome     AuditOutcome
  /// Machine-readable reason code (e.g. "invalid_credentials", "FORBIDDEN").
  reason      String?
  ipAddress   String?
  /// Small, non-sensitive context (changed column names, request path, role ids).
  metadata    Json?

  @@index([clinicId, occurredAt])
  @@index([actorUserId, occurredAt])
  @@index([action, occurredAt])
  @@map("audit_events")
}

// ---------------------------------------------------------------------------
// Lab reports & patient documents (migration 20261021000000_patient_documents)
// ---------------------------------------------------------------------------
// The runtime role has SELECT only on these tables (RLS: clinical rows for
// clinical readers, administrative rows for patient_document.view holders,
// UPLOADING/FAILED never visible). Every write is an app.* SECURITY DEFINER
// function — see src/server/data/documents.ts and lab-reports.ts. Files live in
// the private "patient-documents" Storage bucket under `storageKey`
// ("<clinicId>/<id>", enforced by a CHECK constraint).

enum DocumentCategory {
  LAB_REPORT
  IMAGING
  DISCHARGE_SUMMARY
  REFERRAL
  CLINICAL_OTHER
  ID_PROOF
  INSURANCE
  CONSENT
  ADMIN_OTHER
}

enum DocumentStatus {
  UPLOADING
  AVAILABLE
  FAILED
  ARCHIVED
}

enum DocumentArchiveReason {
  UPLOADED_IN_ERROR
  WRONG_PATIENT
  DUPLICATE
  ILLEGIBLE
  SUPERSEDED
  OTHER
}

enum LabReportStatus {
  PENDING
  AVAILABLE
  REVIEWED
}

model LabReport {
  id                  String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clinicId            String          @db.Uuid
  branchId            String          @db.Uuid
  patientId           String          @db.Uuid
  consultationId      String?         @db.Uuid
  orderedByDoctorId   String?         @db.Uuid
  testType            String
  title               String
  status              LabReportStatus @default(PENDING)
  resultDate          DateTime?       @db.Date
  /// Array (≤100) of {parameter, value, unit, range, flag}; validated by app.set_lab_report_values.
  values              Json            @default("[]")
  notes               String?
  reviewedByUserId    String?         @db.Uuid
  reviewedAt          DateTime?       @db.Timestamptz(6)
  sharedWithPatientAt DateTime?       @db.Timestamptz(6)
  sharedByUserId      String?         @db.Uuid
  createdByUserId     String          @db.Uuid
  createdAt           DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime        @default(now()) @db.Timestamptz(6)

  clinic       Clinic            @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  branch       Branch            @relation(fields: [clinicId, branchId], references: [clinicId, id], onDelete: Restrict)
  patient      Patient           @relation(fields: [clinicId, patientId], references: [clinicId, id], onDelete: Restrict)
  consultation Consultation?     @relation(fields: [clinicId, consultationId], references: [clinicId, id], onDelete: Restrict)
  orderedBy    DoctorProfile?    @relation(fields: [clinicId, orderedByDoctorId], references: [clinicId, id], onDelete: Restrict)
  reviewedBy   User?             @relation("LabReportReviewer", fields: [reviewedByUserId], references: [id], onDelete: Restrict)
  sharedBy     User?             @relation("LabReportSharer", fields: [sharedByUserId], references: [id], onDelete: Restrict)
  createdBy    User              @relation("LabReportCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  documents    PatientDocument[]

  @@unique([clinicId, id])
  @@index([clinicId, patientId])
  @@index([clinicId, status, createdAt])
  @@map("lab_reports")
}

model PatientDocument {
  id               String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clinicId         String                 @db.Uuid
  branchId         String                 @db.Uuid
  patientId        String                 @db.Uuid
  labReportId      String?                @db.Uuid
  consultationId   String?                @db.Uuid
  category         DocumentCategory
  title            String
  /// Sanitised display name only — never used as a storage path.
  originalFilename String
  mimeType         String
  sizeBytes        Int
  sha256           String
  /// "<clinicId>/<id>" (CHECK constraint); the only object key the server reads or writes for this row.
  storageKey       String                 @unique
  status           DocumentStatus         @default(UPLOADING)
  uploadedByUserId String                 @db.Uuid
  uploadedAt       DateTime?              @db.Timestamptz(6)
  failedAt         DateTime?              @db.Timestamptz(6)
  archivedAt       DateTime?              @db.Timestamptz(6)
  archivedByUserId String?                @db.Uuid
  archiveReason    DocumentArchiveReason?
  archiveNote      String?
  createdAt        DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime               @default(now()) @db.Timestamptz(6)

  clinic       Clinic        @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  branch       Branch        @relation(fields: [clinicId, branchId], references: [clinicId, id], onDelete: Restrict)
  patient      Patient       @relation(fields: [clinicId, patientId], references: [clinicId, id], onDelete: Restrict)
  labReport    LabReport?    @relation(fields: [clinicId, labReportId], references: [clinicId, id], onDelete: Restrict)
  consultation Consultation? @relation(fields: [clinicId, consultationId], references: [clinicId, id], onDelete: Restrict)
  uploadedBy   User          @relation("DocumentUploader", fields: [uploadedByUserId], references: [id], onDelete: Restrict)
  archivedBy   User?         @relation("DocumentArchiver", fields: [archivedByUserId], references: [id], onDelete: Restrict)

  @@index([clinicId, patientId, status])
  @@index([clinicId, labReportId])
  @@index([clinicId, patientId, sha256])
  @@index([status, createdAt])
  @@map("patient_documents")
}

