// Sehat Setu — Prisma schema (Prisma 7).
//
// Connection URLs are NOT configured here: in Prisma 7 the CLI reads its URL
// from prisma.config.ts (DIRECT_URL), and the app connects at runtime through
// the pg driver adapter in src/server/prisma.ts (DATABASE_URL).
//
// Multi-tenancy: every tenant-owned row carries `clinicId`. Relations between
// tenant-owned rows use COMPOSITE foreign keys over (clinicId, id), so the
// database itself rejects e.g. an appointment whose branch, patient, or doctor
// belongs to a different clinic. This guarantees consistency only — it does
// not authorize anyone. Server-side queries must still scope every read and
// write to the caller's clinic/branch, and Row-Level Security policies are
// still to be written before any real patient data is stored.
//
// Money is stored as integer paise (1 INR = 100 paise) to avoid floating-point
// rounding. Deletion rules default to Restrict: clinical and billing records
// must never disappear as a side effect of deleting a parent row. Only pure
// child rows (line items, join rows) cascade with their parent.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum ClinicStatus {
  ACTIVE
  SUSPENDED
  PENDING
}

enum RecordStatus {
  ACTIVE
  INACTIVE
}

enum PermissionEffect {
  GRANT
  REVOKE
}

enum LabTestCategory {
  PATHOLOGY
  RADIOLOGY
  CARDIOLOGY
  OTHER
}

enum UserStatus {
  ACTIVE
  INVITED
  DISABLED
}

enum RoleKey {
  ADMINISTRATOR
  CLINIC_MANAGER
  DOCTOR
  RECEPTIONIST
  NURSE
  PATIENT
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum PatientStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum AppointmentType {
  IN_PERSON
  ONLINE
  FOLLOW_UP
  WALK_IN
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  CHECKED_IN
  IN_CONSULTATION
  COMPLETED
  CANCELLED
  NO_SHOW
  /// A patient's self-booked request awaiting reception (holds its slot; not on the doctor's schedule).
  PENDING_APPROVAL
  /// A declined request (frees the slot; kept with its reason and audit history).
  REJECTED
}

enum ConsultationStatus {
  IN_PROGRESS
  COMPLETED
}

enum PrescriptionStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum DosageForm {
  TABLET
  CAPSULE
  SYRUP
  INJECTION
  OINTMENT
  DROPS
  INHALER
  // Added by migration 20261018000000_dosage_forms
  CREAM
  GEL
  LOTION
  SUSPENSION
  POWDER
  SACHET
}

enum InvoiceStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  VOID
}

enum LineItemCategory {
  CONSULTATION
  MEDICINE
  LAB_TEST
  PROCEDURE
  OTHER
}

enum PaymentMethod {
  CASH
  UPI
  CARD
  BANK_TRANSFER
  ONLINE
}

enum PaymentStatus {
  SUCCEEDED
  PENDING
  FAILED
  REFUNDED
}

// ---------------------------------------------------------------------------
// Tenancy: Clinic -> Branch -> Department
// ---------------------------------------------------------------------------

model Clinic {
  id          String       @id @default(uuid()) @db.Uuid
  code        String       @unique
  name        String
  email       String
  phone       String
  addressLine String
  city        String
  state       String
  pincode     String
  /// Brand accent colour (hex) for clinic-branded UI.
  brandColor  String?
  currency    String       @default("INR")
  status      ClinicStatus @default(ACTIVE)
  createdAt   DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @db.Timestamptz(6)

  branches       Branch[]
  departments    Department[]
  labTestTypes   LabTestType[]
  settings       ClinicSettings?
  memberships    ClinicMembership[]
  doctorProfiles DoctorProfile[]
  doctorBranches DoctorBranch[]
  patients       Patient[]
  appointments   Appointment[]
  consultations  Consultation[]
  prescriptions  Prescription[]
  invoices       Invoice[]
  payments       Payment[]
  inventoryItems InventoryItem[]
  reorderLevels  InventoryReorderLevel[]
  labReports     LabReport[]
  documents      PatientDocument[]
  expenses       Expense[]
  onlineOrders   OnlinePaymentOrder[]

  @@map("clinics")
}

/// The clinic's own settings (one row per clinic, created by a trigger on
/// clinics; never inserted or deleted by the app). Validated and enforced in
/// migration 20261102000000_clinic_settings: patient booking, slot overlap
/// checks and invoice numbering read these columns.
model ClinicSettings {
  id                      String   @id @default(uuid()) @db.Uuid
  clinicId                String   @unique @db.Uuid
  /// {"mon": {"open": "09:00", "close": "17:00"}, …, "sun": null} (IST).
  weeklyHours             Json
  breakStart              String?  @default("13:00")
  breakEnd                String?  @default("14:00")
  slotMinutes             Int      @default(30)
  onlineBookingEnabled    Boolean  @default(true)
  bookingNeedsApproval    Boolean  @default(true)
  bookingMinNoticeMinutes Int      @default(30)
  bookingMaxDaysAhead     Int      @default(60)
  bookingMaxUpcoming      Int      @default(5)
  patientOnlinePayments   Boolean  @default(true)
  /// Null: "<clinic code>-INV-".
  invoicePrefix           String?
  gstin                   String?
  defaultTaxPercent       Int      @default(0)
  invoiceFooter           String?
  /// PaymentMethod values reception may record.
  paymentMethods          String[] @default(["CASH", "UPI", "CARD", "BANK_TRANSFER", "ONLINE"])
  /// data:image/(png|jpeg|webp);base64,… (at most ~220 KB of image).
  logoDataUrl             String?
  website                 String?
  registrationNumber      String?
  updatedAt               DateTime @updatedAt @db.Timestamptz(6)

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Restrict)

  @@map("clinic_settings")
}

model Branch {
  id           String       @id @default(uuid()) @db.Uuid
  clinicId     String       @db.Uuid
  code         String
  name         String
  addressLine  String
  city         String
  phone        String
  email        String?
  isHeadOffice Boolean      @default(false)
  status       RecordStatus @default(ACTIVE)
  createdAt    DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @db.Timestamptz(6)

  clinic           Clinic                  @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  departments      Department[]
  memberships      ClinicMembership[]
  doctorBranches   DoctorBranch[]
  patients         Patient[]
  appointments     Appointment[]
  invoices         Invoice[]
  inventoryItems   InventoryItem[]
  reorderLevels    InventoryReorderLevel[]
  staffInvitations StaffInvitation[]
  labReports       LabReport[]
  documents        PatientDocument[]
  expenses         Expense[]
  onlineOrders     OnlinePaymentOrder[]

  @@unique([clinicId, code])
  @@unique([clinicId, id])
  @@map("branches")
}

/// The shared catalogue (clinicId null) plus each clinic's own specialties.
/// Names are unique among shared ones and within a clinic, ignoring case
/// (partial expression indexes defined in 20261101000200_clinic_specialties).
model Specialty {
  id          String   @id @default(uuid()) @db.Uuid
  /// Null: shared by every clinic. Set: that clinic's own (visible to it only).
  clinicId    String?  @db.Uuid
  name        String
  description String?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  departments       Department[]
  doctorProfiles    DoctorProfile[]
  invitationDetails StaffInvitationDoctorDetails[]

  @@map("specialties")
}

model Department {
  id          String       @id @default(uuid()) @db.Uuid
  clinicId    String       @db.Uuid
  /// Null for clinic-wide departments; set when the department is branch-specific.
  branchId    String?      @db.Uuid
  specialtyId String?      @db.Uuid
  name        String
  description String?
  status      RecordStatus @default(ACTIVE)
  createdAt   DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @db.Timestamptz(6)

  clinic         Clinic          @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  branch         Branch?         @relation(fields: [clinicId, branchId], references: [clinicId, id], onDelete: Restrict)
  specialty      Specialty?      @relation(fields: [specialtyId], references: [id], onDelete: SetNull)
  doctorProfiles DoctorProfile[]

  @@unique([clinicId, id])
  @@index([clinicId, branchId])
  @@map("departments")
}

/// A clinic's lab test master: the tests doctors order from a consultation.
/// Names are unique per clinic ignoring case (lab_test_types_clinic_name_key,
/// an expression index on lower("name"), defined in the migration only).
model LabTestType {
  id        String          @id @default(uuid()) @db.Uuid
  clinicId  String          @db.Uuid
  name      String
  category  LabTestCategory @default(OTHER)
  status    RecordStatus    @default(ACTIVE)
  createdAt DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt DateTime        @updatedAt @db.Timestamptz(6)

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Restrict)

  @@unique([clinicId, id])
  @@map("lab_test_types")
}

// ---------------------------------------------------------------------------
// Identity, roles & permissions
// ---------------------------------------------------------------------------

/// A person who can (eventually) sign in. Holds no password: credentials live
/// with the authentication provider, linked via `authProviderId`.
model User {
  id             String     @id @default(uuid()) @db.Uuid
  email          String     @unique
  name           String
  phone          String?
  status         UserStatus @default(INVITED)
  /// The auth provider's user id (e.g. Supabase Auth `auth.users.id`). Null until the account is provisioned.
  authProviderId String?    @unique
  createdAt      DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime   @updatedAt @db.Timestamptz(6)

  memberships        ClinicMembership[]
  stockMovements     StockMovement[]
  doctorProfile      DoctorProfile?
  patient            Patient?
  invitationsSent    StaffInvitation[]  @relation("InvitationInviter")
  labReportsCreated  LabReport[]        @relation("LabReportCreator")
  labReportsReviewed LabReport[]        @relation("LabReportReviewer")
  labReportsShared   LabReport[]        @relation("LabReportSharer")
  documentsUploaded  PatientDocument[]  @relation("DocumentUploader")
  documentsArchived  PatientDocument[]  @relation("DocumentArchiver")
  linkCodesIssued    PatientLinkCode[]  @relation("LinkCodeIssuer")
  linkCodesRedeemed  PatientLinkCode[]  @relation("LinkCodeRedeemer")
  linkCodesRevoked   PatientLinkCode[]  @relation("LinkCodeRevoker")
  intakeProfilesReported PatientIntakeProfile[] @relation("IntakeReporter")
  symptomReportsReported PatientSymptomReport[] @relation("SymptomReporter")
  expensesRecorded   Expense[]          @relation("ExpenseRecorder")
  appointmentsApproved Appointment[]    @relation("AppointmentApprover")
  appointmentsRejected Appointment[]    @relation("AppointmentRejecter")
  onlineOrdersCreated  OnlinePaymentOrder[] @relation("OnlineOrderCreator")
  expensesVoided     Expense[]          @relation("ExpenseVoider")

  @@map("users")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  key         RoleKey  @unique
  name        String
  description String?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  permissions      RolePermission[]
  memberships      ClinicMembership[]
  staffInvitations StaffInvitation[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  /// Dot-delimited key, e.g. "patient.view" — matches src/data/permission-catalog.ts.
  key         String   @unique
  name        String
  module      String
  description String?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @db.Uuid
  permissionId String @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

/// A per-member change to the role's default permissions: GRANT adds one,
/// REVOKE removes one. Written only by app.set_member_permissions /
/// app.change_member_role; read by app.staff_can and the session loader.
/// Foreign keys (clinic, membership, permission, creator) are defined in the migration.
model MemberPermissionOverride {
  id              String           @id @default(uuid()) @db.Uuid
  clinicId        String           @db.Uuid
  membershipId    String           @db.Uuid
  permissionId    String           @db.Uuid
  effect          PermissionEffect
  createdByUserId String           @db.Uuid
  createdAt       DateTime         @default(now()) @db.Timestamptz(6)

  @@unique([membershipId, permissionId])
  @@index([clinicId])
  @@map("member_permission_overrides")
}

/// Grants a user a role within one clinic, optionally limited to one branch.
/// Authorization decisions resolve the caller's clinic/branch scope from here.
model ClinicMembership {
  id        String       @id @default(uuid()) @db.Uuid
  userId    String       @db.Uuid
  clinicId  String       @db.Uuid
  /// Null = clinic-wide access; set = restricted to this branch.
  branchId  String?      @db.Uuid
  roleId    String       @db.Uuid
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt DateTime     @updatedAt @db.Timestamptz(6)

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  clinic Clinic  @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  branch Branch? @relation(fields: [clinicId, branchId], references: [clinicId, id], onDelete: Restrict)
  role   Role    @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([userId, clinicId, roleId])
  @@index([clinicId, branchId])
  @@map("clinic_memberships")
}

// ---------------------------------------------------------------------------
// Doctors
// ---------------------------------------------------------------------------

model DoctorProfile {
  id                   String       @id @default(uuid()) @db.Uuid
  userId               String       @unique @db.Uuid
  clinicId             String       @db.Uuid
  specialtyId          String       @db.Uuid
  departmentId         String?      @db.Uuid
  qualifications       String
  registrationNumber   String
  experienceYears      Int
  consultationFeePaise Int
  bio                  String?
  onlineConsultation   Boolean      @default(false)
  status               RecordStatus @default(ACTIVE)
  createdAt            DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime     @updatedAt @db.Timestamptz(6)

  user         User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  clinic       Clinic         @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  specialty    Specialty      @relation(fields: [specialtyId], references: [id], onDelete: Restrict)
  department   Department?    @relation(fields: [clinicId, departmentId], references: [clinicId, id], onDelete: Restrict)
  branches     DoctorBranch[]
  appointments Appointment[]
  labReports   LabReport[]

  @@unique([clinicId, id])
  @@unique([clinicId, registrationNumber])
  @@index([clinicId, specialtyId])
  @@map("doctor_profiles")
}

/// Which branches a doctor practises at (a doctor can cover several).
model DoctorBranch {
  doctorId  String   @db.Uuid
  branchId  String   @db.Uuid
  clinicId  String   @db.Uuid
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  clinic Clinic        @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  doctor DoctorProfile @relation(fields: [clinicId, doctorId], references: [clinicId, id], onDelete: Cascade)
  branch Branch        @relation(fields: [clinicId, branchId], references: [clinicId, id], onDelete: Cascade)

  @@id([doctorId, branchId])
  @@index([clinicId, branchId])
  @@map("doctor_branches")
}

// ---------------------------------------------------------------------------
// Patients
// ---------------------------------------------------------------------------

/// Patients are clinic-scoped records: the same person visiting two clinics
/// has one record per clinic, so each clinic only ever sees its own data.
model Patient {
  id                    String        @id @default(uuid()) @db.Uuid
  clinicId              String        @db.Uuid
  /// Branch where the patient registered.
  branchId              String        @db.Uuid
  /// Optional link to a patient-portal login.
  userId                String?       @unique @db.Uuid
  /// Human-facing number, unique within the clinic, e.g. "AAR-P-00012".
  patientNumber         String
  name                  String
  dateOfBirth           DateTime      @db.Date
  gender                Gender
  phone                 String
  email                 String?
  bloodGroup            String?
  addressLine           String?
  city                  String?
  allergies             String[]
  chronicConditions     String[]
  emergencyContactName  String?
  emergencyContactPhone String?
  status                PatientStatus @default(ACTIVE)
  createdAt             DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime      @updatedAt @db.Timestamptz(6)

  clinic       Clinic            @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  branch       Branch            @relation(fields: [clinicId, branchId], references: [clinicId, id], onDelete: Restrict)
  user         User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  appointments Appointment[]
  invoices     Invoice[]
  labReports   LabReport[]
  documents    PatientDocument[]
  onlineOrders OnlinePaymentOrder[]
  linkCodes    PatientLinkCode[]
  /// At most one (patient_intake_profiles."patientId" is unique).
  intakeProfiles PatientIntakeProfile[]
  symptomReports PatientSymptomReport[]

  @@unique([clinicId, patientNumber])
  @@unique([clinicId, id])
  @@index([clinicId, name])
  @@index([clinicId, phone])
  @@map("patients")
}

// ---------------------------------------------------------------------------
// Appointments & clinical records
// ---------------------------------------------------------------------------

model Appointment {
  id              String            @id @default(uuid()) @db.Uuid
  clinicId        String            @db.Uuid
  branchId        String            @db.Uuid
  patientId       String            @db.Uuid
  doctorId        String            @db.Uuid
  startsAt        DateTime          @db.Timestamptz(6)
  durationMinutes Int               @default(30)
  type            AppointmentType   @default(IN_PERSON)
  status          AppointmentStatus @default(SCHEDULED)
  reason          String
  notes           String?
  checkedInAt     DateTime?         @db.Timestamptz(6)
  cancelledAt     DateTime?         @db.Timestamptz(6)
  /// Reception's decision on a patient's request. Written only by
  /// app.approve_patient_booking / app.reject_patient_booking (guard trigger).
  approvedAt       DateTime?        @db.Timestamptz(6)
  approvedByUserId String?          @db.Uuid
  rejectedAt       DateTime?        @db.Timestamptz(6)
  rejectedByUserId String?          @db.Uuid
  rejectionReason  String?
  createdAt       DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime          @updatedAt @db.Timestamptz(6)

  approvedBy   User?         @relation("AppointmentApprover", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  rejectedBy   User?         @relation("AppointmentRejecter", fields: [rejectedByUserId], references: [id], onDelete: SetNull)
  clinic       Clinic        @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  branch       Branch        @relation(fields: [clinicId, branchId], references: [clinicId, id], onDelete: Restrict)
  patient      Patient       @relation(fields: [clinicId, patientId], references: [clinicId, id], onDelete: Restrict)
  doctor       DoctorProfile @relation(fields: [clinicId, doctorId], references: [clinicId, id], onDelete: Restrict)
  consultation Consultation?
  invoice      Invoice?
  symptomReports PatientSymptomReport[]
  onlineOrders   OnlinePaymentOrder[]

  @@unique([clinicId, id])
  @@index([clinicId, startsAt])
  @@index([clinicId, branchId, startsAt])
  @@index([doctorId, startsAt])
  @@index([patientId, startsAt])
  @@map("appointments")
}

model Consultation {
  id              String             @id @default(uuid()) @db.Uuid
  clinicId        String             @db.Uuid
  appointmentId   String             @db.Uuid
  chiefComplaint  String
  notes           String?
  diagnosis       String[]
  symptoms        String[]           @default([])
  history         String?
  allergiesNoted  String[]           @default([])
  /// Measured vitals as a small JSON object (keys validated by src/server/data/clinical.ts).
  vitals          Json?
  examination     String?
  treatmentPlan   String?
  labTestsOrdered String[]           @default([])
  followUpDate    DateTime?          @db.Date
  status          ConsultationStatus @default(IN_PROGRESS)
  completedAt     DateTime?          @db.Timestamptz(6)
  createdAt       DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime           @updatedAt @db.Timestamptz(6)

  clinic        Clinic            @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  appointment   Appointment       @relation(fields: [clinicId, appointmentId], references: [clinicId, id], onDelete: Restrict)
  prescriptions Prescription[]
  labReports    LabReport[]
  documents     PatientDocument[]

  @@unique([clinicId, appointmentId])
  @@unique([clinicId, id])
  @@index([clinicId, createdAt])
  @@map("consultations")
}

/// Global medicine catalog (not tenant-owned). The runtime role can only read
/// it; administrators add entries through app.create_catalog_medicine()
/// (migration 20261018000100). Duplicates of the normalised name + strength +
/// dosage form are blocked by the expression index medicines_normalized_key,
/// which Prisma can't express.
model Medicine {
  id          String     @id @default(uuid()) @db.Uuid
  name        String
  genericName String
  strength    String
  dosageForm  DosageForm
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime   @updatedAt @db.Timestamptz(6)

  prescriptionItems PrescriptionItem[]
  inventoryItems    InventoryItem[]
  reorderLevels     InventoryReorderLevel[]

  @@unique([name, strength, dosageForm])
  @@map("medicines")
}

model Prescription {
  id                 String             @id @default(uuid()) @db.Uuid
  clinicId           String             @db.Uuid
  consultationId     String             @db.Uuid
  /// Human-facing number, unique within the clinic.
  prescriptionNumber String
  status             PrescriptionStatus @default(ACTIVE)
  notes              String?
  issuedAt           DateTime           @db.Timestamptz(6)
  createdAt          DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime           @updatedAt @db.Timestamptz(6)

  clinic       Clinic             @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  consultation Consultation       @relation(fields: [clinicId, consultationId], references: [clinicId, id], onDelete: Restrict)
  items        PrescriptionItem[]

  @@unique([clinicId, prescriptionNumber])
  @@index([consultationId])
  @@index([clinicId, issuedAt])
  @@map("prescriptions")
}

model PrescriptionItem {
  id             String  @id @default(uuid()) @db.Uuid
  prescriptionId String  @db.Uuid
  medicineId     String  @db.Uuid
  /// e.g. "1 tablet"
  dosage         String
  /// e.g. "Twice daily"
  frequency      String
  durationDays   Int
  instructions   String?
  /// e.g. "Oral", "Topical"
  route          String?

  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  medicine     Medicine     @relation(fields: [medicineId], references: [id], onDelete: Restrict)

  @@index([prescriptionId])
  @@map("prescription_items")
}

// ---------------------------------------------------------------------------
// Billing
// ---------------------------------------------------------------------------

model Invoice {
  id            String        @id @default(uuid()) @db.Uuid
  clinicId      String        @db.Uuid
  branchId      String        @db.Uuid
  patientId     String        @db.Uuid
  appointmentId String?       @db.Uuid
  /// Human-facing number, unique within the clinic, e.g. "AAR-INV-2026-0001".
  invoiceNumber String
  issuedAt      DateTime      @db.Timestamptz(6)
  dueDate       DateTime?     @db.Date
  subtotalPaise Int
  discountPaise Int           @default(0)
  taxPaise      Int           @default(0)
  totalPaise    Int
  status        InvoiceStatus @default(PENDING)
  createdAt     DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime      @updatedAt @db.Timestamptz(6)

  clinic      Clinic            @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  branch      Branch            @relation(fields: [clinicId, branchId], references: [clinicId, id], onDelete: Restrict)
  patient     Patient           @relation(fields: [clinicId, patientId], references: [clinicId, id], onDelete: Restrict)
  appointment Appointment?      @relation(fields: [clinicId, appointmentId], references: [clinicId, id], onDelete: Restrict)
  lineItems   InvoiceLineItem[]
  payments    Payment[]
  onlineOrders OnlinePaymentOrder[]

  @@unique([clinicId, appointmentId])
