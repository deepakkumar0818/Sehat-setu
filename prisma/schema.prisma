  branch    Branch          @relation(fields: [clinicId, branchId], references: [clinicId, id], onDelete: Restrict)
  medicine  Medicine        @relation(fields: [medicineId], references: [id], onDelete: Restrict)
  movements StockMovement[]

  @@unique([clinicId, id])
  @@index([clinicId, branchId, medicineId])
