  updatedAt    DateTime @updatedAt @db.Timestamptz(6)

  clinic   Clinic   @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  branch   Branch   @relation(fields: [clinicId, branchId], references: [clinicId, id], onDelete: Restrict)
  medicine Medicine @relation(fields: [medicineId], references: [id], onDelete: Restrict)

  @@unique([clinicId, branchId, medicineId])
  @@map("inventory_reorder_levels")
}

/// Append-only stock ledger. clinicId, branchId, quantityAfter, actorUserId and
/// occurredAt are set by the database trigger, not by the caller.
model StockMovement {
  id                 String            @id @default(uuid()) @db.Uuid
  clinicId           String            @db.Uuid
  branchId           String            @db.Uuid
  inventoryItemId    String            @db.Uuid
  type               StockMovementType
  quantityDelta      Int
  quantityAfter      Int               @default(0)
  actorUserId        String            @db.Uuid
  occurredAt         DateTime          @default(now()) @db.Timestamptz(6)
